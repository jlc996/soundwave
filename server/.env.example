# Copy to .env and fill in. NEVER commit .env.

PORT=5000
CLIENT_URL=http://localhost:5173

# From Atlas: Connect -> Drivers.
# Replace <password> with the real one (delete the angle brackets too),
# and add your database name before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/soundwave?retryWrites=true&w=majority
